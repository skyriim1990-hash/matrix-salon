---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import site from '../data/site.json';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const bookHref = site.bookingUrl && site.bookingUrl.length > 0 ? site.bookingUrl : '/contact';
---

<Layout title="Services & Prices" description="Cuts, colour, balayage, styling and bridal hair — services and prices.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="text-4xl text-brand-dark">Services & Prices</h1>
      <p class="mt-4 text-ink/70">
        Prices are a guide and may vary with hair length and thickness. A free consultation is included with colour services.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <ServiceCard
          title={s.data.title}
          price={s.data.price}
          duration={s.data.duration}
          description={s.data.description}
        />
      ))}
    </div>

    <div class="mt-14 rounded-3xl bg-brand-dark px-6 py-12 text-center text-white">
      <h2 class="text-3xl">Ready for a new look?</h2>
      <p class="mt-3 text-cream/80">Get in touch to book your appointment.</p>
      <a href={bookHref} class="mt-6 inline-block rounded-full bg-white px-7 py-3 font-medium text-brand-dark transition hover:bg-cream">
        Book now
      </a>
    </div>
  </section>
</Layout>
