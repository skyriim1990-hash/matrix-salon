---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

const phoneHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;
---

<Layout title="Contact & Booking" description="Find us, opening hours, and how to book an appointment.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="text-4xl text-brand-dark">Contact & Booking</h1>
      <p class="mt-4 text-ink/70">
        To book, give us a call or send a message — we'll find a time that works for you.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <!-- Details -->
      <div class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-brand-light/60">
        <h2 class="text-2xl text-brand-dark">Get in touch</h2>
        <dl class="mt-6 space-y-5 text-sm">
          <div>
            <dt class="font-medium text-ink/60">Phone</dt>
            <dd><a href={phoneHref} class="text-lg text-brand hover:underline">{site.phone}</a></dd>
          </div>
          <div>
            <dt class="font-medium text-ink/60">Email</dt>
            <dd><a href={`mailto:${site.email}`} class="text-lg text-brand hover:underline">{site.email}</a></dd>
          </div>
          <div>
            <dt class="font-medium text-ink/60">Address</dt>
            <dd><a href={site.mapsUrl} class="text-lg text-brand hover:underline">{site.address}</a></dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={phoneHref} class="rounded-full bg-brand-dark px-6 py-3 font-medium text-white transition hover:bg-brand">
            Call to book
          </a>
          {site.bookingUrl && site.bookingUrl.length > 0 && (
            <a href={site.bookingUrl} class="rounded-full border border-brand-dark px-6 py-3 font-medium text-brand-dark transition hover:bg-brand-light/40">
              Book online
            </a>
          )}
        </div>
      </div>

      <!-- Hours -->
      <div class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-brand-light/60">
        <h2 class="text-2xl text-brand-dark">Opening hours</h2>
        <ul class="mt-6 divide-y divide-brand-light/60 text-sm">
          {site.hours.map((h) => (
            <li class="flex justify-between py-3">
              <span class="font-medium">{h.day}</span>
              <span class="text-ink/70">{h.time}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Layout>
