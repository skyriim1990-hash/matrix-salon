---
import Layout from '../layouts/Layout.astro';
---

<Layout lang="bg" title="404 — Страницата не е намерена">
  <section class="min-h-[68vh] flex items-center justify-center px-4 text-center">
    <div class="reveal">
      <p class="font-display text-7xl sm:text-9xl text-gold leading-none">404</p>
      <h1 class="mt-4 text-3xl sm:text-4xl text-cream">Страницата не е намерена</h1>
      <p class="mt-4 max-w-md mx-auto text-sand/75">Възможно е връзката да е сгрешена или страницата да е преместена. / This page could not be found.</p>
      <a href="/" class="mt-9 inline-block rounded-full bg-gold px-8 py-3.5 text-sm tracking-widest uppercase text-ink transition hover:bg-gold-soft">
        Към началото
      </a>
    </div>
  </section>
</Layout>
