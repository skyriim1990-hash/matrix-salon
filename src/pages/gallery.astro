---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const gallery = (await getCollection('gallery')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Gallery" description="A gallery of recent cuts, colour and styling work.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="text-4xl text-brand-dark">Gallery</h1>
      <p class="mt-4 text-ink/70">A selection of our recent work. Follow along on social for more.</p>
    </div>

    <div class="mt-12 columns-2 gap-4 sm:columns-3 [&>img]:mb-4">
      {gallery.map((g) => (
        <img
          src={g.data.image}
          alt={g.data.alt}
          loading="lazy"
          class="w-full rounded-2xl object-cover"
        />
      ))}
    </div>
  </section>
</Layout>
