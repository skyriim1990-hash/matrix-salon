---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import site from '../data/site.json';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const gallery = (await getCollection('gallery'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const bookHref = site.bookingUrl && site.bookingUrl.length > 0 ? site.bookingUrl : '/contact';
---

<Layout>
  <!-- Hero -->
  <section class="relative isolate">
    <img src="/images/hero.svg" alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-brand-dark/55"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-28 sm:py-40 text-center text-white">
      <p class="mb-4 text-sm uppercase tracking-[0.3em] text-cream/80">{site.address}</p>
      <h1 class="text-4xl sm:text-6xl leading-tight">{site.businessName}</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-cream/90">{site.tagline}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a href={bookHref} class="rounded-full bg-white px-7 py-3 font-medium text-brand-dark transition hover:bg-cream">
          Book an appointment
        </a>
        <a href="/services" class="rounded-full border border-white/70 px-7 py-3 font-medium text-white transition hover:bg-white/10">
          View services
        </a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
    <h2 class="text-3xl text-brand-dark">Welcome</h2>
    <p class="mt-5 text-lg leading-relaxed text-ink/75">{site.intro}</p>
  </section>

  <!-- Services preview -->
  <section class="bg-white/60 border-y border-brand-light/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl text-brand-dark">Our services</h2>
        <p class="mt-3 text-ink/70">A few of the things we love to do.</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.slice(0, 6).map((s) => (
          <ServiceCard
            title={s.data.title}
            price={s.data.price}
            duration={s.data.duration}
            description={s.data.description}
          />
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/services" class="font-medium text-brand-dark underline-offset-4 hover:underline">
          See all services & prices →
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
    <div class="text-center">
      <h2 class="text-3xl text-brand-dark">Recent looks</h2>
      <p class="mt-3 text-ink/70">A peek at our work.</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {gallery.map((g) => (
        <img
          src={g.data.image}
          alt={g.data.alt}
          loading="lazy"
          class="aspect-square w-full rounded-2xl object-cover"
        />
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href="/gallery" class="font-medium text-brand-dark underline-offset-4 hover:underline">
        View full gallery →
      </a>
    </div>
  </section>
</Layout>
