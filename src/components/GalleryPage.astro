---
import { Picture, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { salon } from '../lib/salonImages';
import { ui, business, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const fmt = ['avif', 'webp'] as const;

// Filter tabs (bilingual)
const cats = [
  { id: 'hair', bg: 'Коса', en: 'Hair' },
  { id: 'headspa', bg: 'Head spa', en: 'Head spa' },
  { id: 'makeup', bg: 'Грим', en: 'Makeup' },
  { id: 'nails', bg: 'Маникюр и педикюр', en: 'Manicure & Pedicure' },
];

// Each photo with its category. Add new photos here as they come in.
const items = [
  ...Array.from({ length: 13 }, (_, i) => ({ name: `look-${i + 1}`, cat: 'hair' })),
  ...Array.from({ length: 6 }, (_, i) => ({ name: `headspa-${i + 1}`, cat: 'headspa' })),
  ...Array.from({ length: 6 }, (_, i) => ({ name: `makeup-${i + 1}`, cat: 'makeup' })),
  ...Array.from({ length: 9 }, (_, i) => ({ name: `nails-${i + 1}`, cat: 'nails' })),
].filter((it) => salon[it.name]);

// Large versions for the lightbox
const fulls: Record<string, string> = {};
for (const it of items) {
  fulls[it.name] = (await getImage({ src: salon[it.name], width: 1400, format: 'webp' })).src;
}
---

<Layout lang={lang} title={`${t.nav.gallery} — ${business.name}`} description={t.meta.description}>
  <section class="pt-36 pb-24 sm:pb-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="rule mb-6"></span>
        <p class="eyebrow">{t.gallery.eyebrow}</p>
        <h1 class="mt-4 text-5xl sm:text-6xl text-cream">{t.gallery.title}</h1>
        <p class="mt-5 text-sand/75">{t.gallery.text}</p>
      </div>

      <!-- Category filter tabs -->
      <div id="gallery-tabs" class="mt-10 flex flex-wrap justify-center gap-2.5 reveal">
        {cats.map((c, i) => (
          <button
            type="button"
            data-filter={c.id}
            class={`gtab rounded-full border px-5 py-2 text-xs tracking-widest uppercase transition-colors ${
              i === 0 ? 'border-gold bg-gold text-ink' : 'border-cream/25 text-cream/75 hover:border-gold hover:text-gold'
            }`}
          >
            {lang === 'bg' ? c.bg : c.en}
          </button>
        ))}
      </div>

      <div id="gallery-grid" class="mt-12 columns-2 md:columns-3 gap-4 [&>*]:mb-4 reveal">
        {items.map((it, i) => (
          <div class="gitem zoom-img rounded-xl break-inside-avoid cursor-pointer" data-cat={it.cat} data-full={fulls[it.name]}>
            <Picture
              src={salon[it.name]}
              formats={fmt}
              fallbackFormat="webp"
              alt={`${t.gallery.title} ${i + 1}`}
              widths={[400, 700, 1000]}
              sizes="(min-width:768px) 33vw, 50vw"
              loading="lazy"
              pictureAttributes={{ class: 'block' }}
              class="w-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label={t.nav.gallery}>
    <button id="lb-close" type="button" aria-label="Close" class="absolute top-4 right-4 grid place-items-center h-11 w-11 rounded-full bg-ink/70 text-cream hover:text-gold transition-colors">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <button id="lb-prev" type="button" aria-label="Previous" class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 grid place-items-center h-12 w-12 rounded-full bg-ink/70 text-cream hover:text-gold transition-colors">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6"/></svg>
    </button>
    <img id="lb-img" alt={t.gallery.title} />
    <button id="lb-next" type="button" aria-label="Next" class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 grid place-items-center h-12 w-12 rounded-full bg-ink/70 text-cream hover:text-gold transition-colors">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>

  <script>
    const tabs = document.querySelectorAll('#gallery-tabs .gtab');
    const grid = document.getElementById('gallery-grid')!;
    const tiles = Array.from(grid.querySelectorAll('.gitem')) as HTMLElement[];
    const on = ['border-gold', 'bg-gold', 'text-ink'];
    const off = ['border-cream/25', 'text-cream/75', 'hover:border-gold', 'hover:text-gold'];

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabs.forEach((b) => { b.classList.add(...off); b.classList.remove(...on); });
        btn.classList.add(...on); btn.classList.remove(...off);
        const f = btn.getAttribute('data-filter');
        tiles.forEach((it) => { it.style.display = it.getAttribute('data-cat') === f ? '' : 'none'; });
      });
    });
    if (tabs[0]) (tabs[0] as HTMLElement).click();

    // Lightbox
    const lb = document.getElementById('lightbox')!;
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    let visible: HTMLElement[] = [];
    let idx = 0;
    const show = () => { const t = visible[idx]; if (t) lbImg.src = t.getAttribute('data-full') || ''; };
    const openAt = (tile: HTMLElement) => {
      visible = tiles.filter((el) => el.style.display !== 'none');
      idx = visible.indexOf(tile);
      show();
      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
    };
    const close = () => { lb.classList.remove('open'); document.body.style.overflow = ''; lbImg.src = ''; };
    const step = (d: number) => { if (visible.length) { idx = (idx + d + visible.length) % visible.length; show(); } };

    tiles.forEach((t) => t.addEventListener('click', () => openAt(t)));
    document.getElementById('lb-close')!.addEventListener('click', close);
    document.getElementById('lb-prev')!.addEventListener('click', (e) => { e.stopPropagation(); step(-1); });
    document.getElementById('lb-next')!.addEventListener('click', (e) => { e.stopPropagation(); step(1); });
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });
  </script>
</Layout>
