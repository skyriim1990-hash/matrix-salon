---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { salon } from '../lib/salonImages';
import { ui, business, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const fmt = ['avif', 'webp'] as const;

// Filter tabs (bilingual)
const cats = [
  { id: 'hair', bg: 'Коса', en: 'Hair' },
  { id: 'headspa', bg: 'Head spa', en: 'Head spa' },
  { id: 'makeup', bg: 'Грим', en: 'Makeup' },
  { id: 'nails', bg: 'Маникюр и педикюр', en: 'Manicure & Pedicure' },
];

// Each photo with its category. Add new photos here as they come in.
const items = [
  ...Array.from({ length: 13 }, (_, i) => ({ name: `look-${i + 1}`, cat: 'hair' })),
  ...Array.from({ length: 6 }, (_, i) => ({ name: `headspa-${i + 1}`, cat: 'headspa' })),
  ...Array.from({ length: 4 }, (_, i) => ({ name: `makeup-${i + 1}`, cat: 'makeup' })),
  ...Array.from({ length: 9 }, (_, i) => ({ name: `nails-${i + 1}`, cat: 'nails' })),
].filter((it) => salon[it.name]);
---

<Layout lang={lang} title={`${t.nav.gallery} — ${business.name}`} description={t.meta.description}>
  <section class="pt-36 pb-24 sm:pb-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="rule mb-6"></span>
        <p class="eyebrow">{t.gallery.eyebrow}</p>
        <h1 class="mt-4 text-5xl sm:text-6xl text-cream">{t.gallery.title}</h1>
        <p class="mt-5 text-sand/75">{t.gallery.text}</p>
      </div>

      <!-- Category filter tabs -->
      <div id="gallery-tabs" class="mt-10 flex flex-wrap justify-center gap-2.5 reveal">
        {cats.map((c, i) => (
          <button
            type="button"
            data-filter={c.id}
            class={`gtab rounded-full border px-5 py-2 text-xs tracking-widest uppercase transition-colors ${
              i === 0 ? 'border-gold bg-gold text-ink' : 'border-cream/25 text-cream/75 hover:border-gold hover:text-gold'
            }`}
          >
            {lang === 'bg' ? c.bg : c.en}
          </button>
        ))}
      </div>

      <div id="gallery-grid" class="mt-12 columns-2 md:columns-3 gap-4 [&>*]:mb-4 reveal">
        {items.map((it, i) => (
          <div class="gitem zoom-img rounded-xl break-inside-avoid" data-cat={it.cat}>
            <Picture
              src={salon[it.name]}
              formats={fmt}
              fallbackFormat="webp"
              alt={`${t.gallery.title} ${i + 1}`}
              widths={[400, 700, 1000]}
              sizes="(min-width:768px) 33vw, 50vw"
              loading="lazy"
              pictureAttributes={{ class: 'block' }}
              class="w-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const tabs = document.querySelectorAll('#gallery-tabs .gtab');
    const items = document.querySelectorAll('#gallery-grid .gitem');
    const on = ['border-gold', 'bg-gold', 'text-ink'];
    const off = ['border-cream/25', 'text-cream/75', 'hover:border-gold', 'hover:text-gold'];

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabs.forEach((b) => { b.classList.add(...off); b.classList.remove(...on); });
        btn.classList.add(...on); btn.classList.remove(...off);
        const f = btn.getAttribute('data-filter');
        items.forEach((it) => {
          const show = it.getAttribute('data-cat') === f;
          (it as HTMLElement).style.display = show ? '' : 'none';
        });
      });
    });
    if (tabs[0]) (tabs[0] as HTMLElement).click();
  </script>
</Layout>
