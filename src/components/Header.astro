---
import { ui, business, localize, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const links = [
  { path: '/', label: t.nav.home },
  { path: '/services', label: t.nav.services },
  { path: '/gallery', label: t.nav.gallery },
  { path: '/contact', label: t.nav.contact },
];

// Logical path (without the /en prefix) to detect active link + build the
// language-switch URL for the same page in the other language.
const raw = Astro.url.pathname.replace(/\/$/, '') || '/';
const logical = raw.replace(/^\/en/, '') || '/';
const otherLang: Lang = lang === 'bg' ? 'en' : 'bg';
const switchHref = localize(logical === '' ? '/' : logical, otherLang);

const isActive = (p: string) => (p === '/' ? logical === '/' : logical.startsWith(p));
const bookHref = business.bookingUrl && business.bookingUrl.length > 0 ? business.bookingUrl : localize('/contact', lang);
const bookExternal = Boolean(business.bookingUrl && business.bookingUrl.length > 0);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 border-b border-transparent"
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-8 h-20 flex items-center justify-between">
    <a href={localize('/', lang)} class="flex items-center" aria-label={business.name}>
      <img src={business.logo} alt={business.name} width="362" height="250" class="h-12 sm:h-14 w-auto object-contain" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-9">
      {links.map((l) => (
        <a
          href={localize(l.path, lang)}
          class={`text-[0.82rem] tracking-widest uppercase transition-colors hover:text-gold ${
            isActive(l.path) ? 'text-gold' : 'text-cream/75'
          }`}
        >
          {l.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-4">
      <a
        href={switchHref}
        class="text-[0.8rem] tracking-widest uppercase text-cream/60 hover:text-gold transition-colors"
        aria-label={`Switch to ${otherLang.toUpperCase()}`}
      >
        {otherLang.toUpperCase()}
      </a>
      <a
        href={bookHref}
        {...(bookExternal ? { target: '_blank', rel: 'noopener' } : {})}
        class="hidden sm:inline-block rounded-full border border-gold/70 bg-gold/10 px-6 py-2.5 text-[0.78rem] tracking-widest uppercase text-gold-soft transition-colors hover:bg-gold hover:text-ink"
      >
        {t.nav.book}
      </a>

      <button
        id="menu-toggle"
        class="lg:hidden p-2 text-cream"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-charcoal/98 backdrop-blur border-t border-charcoal-2 px-6 py-6">
    {links.map((l) => (
      <a href={localize(l.path, lang)} class="block py-3 text-sm tracking-widest uppercase text-cream/80 hover:text-gold border-b border-white/5">
        {l.label}
      </a>
    ))}
    <a
      href={bookHref}
      {...(bookExternal ? { target: '_blank', rel: 'noopener' } : {})}
      class="mt-5 block rounded-full bg-gold px-6 py-3 text-center text-[0.8rem] tracking-widest uppercase text-ink"
    >
      {t.nav.book}
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add('bg-ink/85', 'backdrop-blur', 'border-charcoal-2');
      header.classList.remove('border-transparent');
    } else {
      header.classList.remove('bg-ink/85', 'backdrop-blur', 'border-charcoal-2');
      header.classList.add('border-transparent');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
