---
// Renders one price-list category (title + grouped item rows).
interface Item { name: string; desc?: string; time?: string; eur: string; bgn: string }
interface Group { title?: string; items: Item[] }
interface Props {
  cat: { title: string; groups: Group[] };
}
const { cat } = Astro.props;
---

<div>
  <h2 class="text-3xl sm:text-4xl text-cream pb-4 border-b border-gold/30">{cat.title}</h2>
  <div class="mt-8 space-y-9">
    {cat.groups.map((g) => (
      <div>
        {g.title && <p class="eyebrow border-b border-white/10 pb-3">{g.title}</p>}
        <ul class="divide-y divide-white/8">
          {g.items.map((item) => (
            <li class="py-5 flex items-start justify-between gap-6">
              <div class="min-w-0">
                <h3 class="text-lg sm:text-xl text-cream">{item.name}</h3>
                {item.time && <p class="mt-1 text-[0.7rem] uppercase tracking-wider text-sand/45">{item.time}</p>}
                {item.desc && <p class="mt-2 text-sm leading-relaxed text-sand/60">{item.desc}</p>}
              </div>
              <div class="text-right shrink-0">
                <div class="text-xl sm:text-2xl text-gold tabular-nums leading-none">{item.eur}</div>
                <div class="mt-1 text-xs text-sand/55 tabular-nums">{item.bgn}</div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
