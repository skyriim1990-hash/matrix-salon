---
import Layout from '../layouts/Layout.astro';
import { ui, business, localize, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const bookHref = business.bookingUrl && business.bookingUrl.length > 0 ? business.bookingUrl : localize('/contact', lang);
const bookExternal = Boolean(business.bookingUrl && business.bookingUrl.length > 0);
const bookAttrs = bookExternal ? { target: '_blank', rel: 'noopener' } : {};
---

<Layout lang={lang} title={`${t.nav.services} — ${business.name}`} description={t.meta.description}>
  <section class="pt-36 pb-24 sm:pb-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="rule mb-6"></span>
        <p class="eyebrow">{t.offerings.eyebrow}</p>
        <h1 class="mt-4 text-5xl sm:text-6xl text-cream">{t.offerings.title}</h1>
        <p class="mt-5 text-sand/75">{t.offerings.text}</p>
      </div>

      <div class="mt-16 max-w-3xl mx-auto space-y-16">
        {t.offerings.menu.map((cat) => (
          <div class="reveal">
            <h2 class="text-3xl sm:text-4xl text-cream text-center">{cat.title}</h2>
            <div class="mt-10 space-y-9">
              {cat.groups.map((g) => (
                <div>
                  {g.title && (
                    <p class="eyebrow border-b border-gold/25 pb-3">{g.title}</p>
                  )}
                  <ul class="divide-y divide-white/8">
                    {g.items.map((item) => (
                      <li class="py-5 flex items-start justify-between gap-6">
                        <div class="min-w-0">
                          <h3 class="text-lg sm:text-xl text-cream">{item.name}</h3>
                          {item.time && <p class="mt-1 text-[0.7rem] uppercase tracking-wider text-sand/45">{item.time}</p>}
                          {item.desc && <p class="mt-2 text-sm leading-relaxed text-sand/60">{item.desc}</p>}
                        </div>
                        <div class="text-right shrink-0">
                          <div class="text-xl sm:text-2xl text-gold tabular-nums leading-none">{item.eur}</div>
                          <div class="mt-1 text-xs text-sand/55 tabular-nums">{item.bgn}</div>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 rounded-3xl bg-charcoal ring-1 ring-white/8 px-6 py-14 text-center reveal">
        <h2 class="text-3xl sm:text-4xl text-cream">{t.booking.title}</h2>
        <p class="mt-3 text-sand/75">{t.booking.text}</p>
        <a href={bookHref} {...bookAttrs} class="mt-8 inline-block rounded-full bg-gold px-8 py-3.5 text-sm tracking-widest uppercase text-ink transition hover:bg-gold-soft">
          {t.nav.book}
        </a>
      </div>
    </div>
  </section>
</Layout>
