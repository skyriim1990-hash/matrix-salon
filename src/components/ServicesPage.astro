---
import Layout from '../layouts/Layout.astro';
import CategoryMenu from './CategoryMenu.astro';
import NotinoBooking from './NotinoBooking.astro';
import { ui, business, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<Layout lang={lang} title={`${t.nav.services} — ${business.name}`} description={t.meta.description}>
  <section class="pt-36 pb-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="rule mb-6"></span>
        <p class="eyebrow">{t.offerings.eyebrow}</p>
        <h1 class="mt-4 text-5xl sm:text-6xl text-cream">{t.offerings.title}</h1>
        <p class="mt-5 text-sand/75">{t.offerings.text}</p>
      </div>

      <div class="mt-16 grid gap-x-16 gap-y-16 lg:grid-cols-2 items-start">
        <!-- Left: women's -->
        <div class="reveal">
          <CategoryMenu cat={t.offerings.menu[0]} />
        </div>
        <!-- Right: men's, then children's -->
        <div class="reveal space-y-14">
          {t.offerings.menu.slice(1).map((cat) => (
            <CategoryMenu cat={cat} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Booking / Notino field at the bottom -->
  <NotinoBooking lang={lang} />
</Layout>
