---
import { ui, business, localize, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
const address = lang === 'bg' ? business.addressBg : business.addressEn;
const tel = business.phone.replace(/[^+\d]/g, '');

const links = [
  { path: '/', label: t.nav.home },
  { path: '/services', label: t.nav.services },
  { path: '/gallery', label: t.nav.gallery },
  { path: '/contact', label: t.nav.contact },
];
---

<footer class="bg-charcoal border-t border-charcoal-2">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-16 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center">
        <img src={business.logo} alt={business.name} width="362" height="250" class="h-16 w-auto object-contain" />
      </div>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-sand/80">{t.footer.tagline}</p>
      <div class="mt-6 flex gap-4">
        <a href={business.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="text-cream/60 hover:text-gold transition-colors">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 1.8c-3.15 0-3.5.01-4.74.07-.9.04-1.38.19-1.7.32-.43.16-.74.36-1.06.68-.32.32-.52.63-.68 1.06-.13.32-.28.8-.32 1.7-.06 1.24-.07 1.6-.07 4.74s.01 3.5.07 4.74c.04.9.19 1.38.32 1.7.16.43.36.74.68 1.06.32.32.63.52 1.06.68.32.13.8.28 1.7.32 1.24.06 1.6.07 4.74.07s3.5-.01 4.74-.07c.9-.04 1.38-.19 1.7-.32.43-.16.74-.36 1.06-.68.32-.32.52-.63.68-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.6.07-4.74s-.01-3.5-.07-4.74c-.04-.9-.19-1.38-.32-1.7a2.9 2.9 0 0 0-.68-1.06 2.9 2.9 0 0 0-1.06-.68c-.32-.13-.8-.28-1.7-.32-1.24-.06-1.6-.07-4.74-.07zm0 3.06A4.98 4.98 0 1 1 12 17a4.98 4.98 0 0 1 0-9.98zm0 1.8A3.18 3.18 0 1 0 12 15.2a3.18 3.18 0 0 0 0-6.38zm5.2-.72a1.16 1.16 0 1 1-2.32 0 1.16 1.16 0 0 1 2.32 0z"/></svg>
        </a>
        <a href={business.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="text-cream/60 hover:text-gold transition-colors">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h4 class="text-gold text-sm tracking-widest uppercase mb-4">{t.footer.contact}</h4>
      <address class="not-italic text-sm leading-relaxed text-sand/80 space-y-1">
        <a href={business.mapsUrl} target="_blank" rel="noopener" class="block hover:text-gold">{address}</a>
        <a href={`tel:${tel}`} class="block hover:text-gold">{business.phone}</a>
        <a href={`mailto:${business.email}`} class="block hover:text-gold">{business.email}</a>
      </address>
    </div>

    <div>
      <h4 class="text-gold text-sm tracking-widest uppercase mb-4">{t.footer.hours}</h4>
      <ul class="text-sm space-y-1.5 text-sand/80">
        {t.hoursList.map((h) => (
          <li class="flex justify-between gap-4">
            <span>{h.day}</span>
            <span class="text-cream/55 tabular-nums">{h.time}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-cream/45">
      <p>© {year} {business.name}. {t.footer.rights}</p>
      <nav class="flex gap-5">
        {links.map((l) => (
          <a href={localize(l.path, lang)} class="tracking-widest uppercase hover:text-gold">{l.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
