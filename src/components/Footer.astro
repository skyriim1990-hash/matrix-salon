---
import { ui, business, localize, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
const address = lang === 'bg' ? business.addressBg : business.addressEn;
const tel = business.phone.replace(/[^+\d]/g, '');

const links = [
  { path: '/', label: t.nav.home },
  { path: '/services', label: t.nav.services },
  { path: '/gallery', label: t.nav.gallery },
  { path: '/contact', label: t.nav.contact },
];
---

<footer class="bg-charcoal border-t border-charcoal-2">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-16 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center">
        <img src={business.logo} alt={business.name} width="362" height="250" class="h-16 w-auto object-contain" />
      </div>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-sand/80">{t.footer.tagline}</p>
      <div class="mt-6 flex gap-4">
        <a href={business.instagram} target="_blank" rel="noopener" class="text-xs tracking-widest uppercase text-cream/60 hover:text-gold">Instagram</a>
        <a href={business.facebook} target="_blank" rel="noopener" class="text-xs tracking-widest uppercase text-cream/60 hover:text-gold">Facebook</a>
      </div>
    </div>

    <div>
      <h4 class="text-gold text-sm tracking-widest uppercase mb-4">{t.footer.contact}</h4>
      <address class="not-italic text-sm leading-relaxed text-sand/80 space-y-1">
        <a href={business.mapsUrl} target="_blank" rel="noopener" class="block hover:text-gold">{address}</a>
        <a href={`tel:${tel}`} class="block hover:text-gold">{business.phone}</a>
        <a href={`mailto:${business.email}`} class="block hover:text-gold">{business.email}</a>
      </address>
    </div>

    <div>
      <h4 class="text-gold text-sm tracking-widest uppercase mb-4">{t.footer.hours}</h4>
      <ul class="text-sm space-y-1.5 text-sand/80">
        {t.hoursList.map((h) => (
          <li class="flex justify-between gap-4">
            <span>{h.day}</span>
            <span class="text-cream/55 tabular-nums">{h.time}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-cream/45">
      <p>© {year} {business.name}. {t.footer.rights}</p>
      <nav class="flex gap-5">
        {links.map((l) => (
          <a href={localize(l.path, lang)} class="tracking-widest uppercase hover:text-gold">{l.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
