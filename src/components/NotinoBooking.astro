---
import { ui, business, localize, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const bookHref = business.bookingUrl && business.bookingUrl.length > 0 ? business.bookingUrl : localize('/contact', lang);
const bookExternal = Boolean(business.bookingUrl && business.bookingUrl.length > 0);
const bookAttrs = bookExternal ? { target: '_blank', rel: 'noopener' } : {};
---

<section class="pb-24">
  <div class="max-w-3xl mx-auto px-4 sm:px-8">
    <div class="reveal rounded-3xl bg-charcoal ring-1 ring-white/8 px-6 py-12 sm:py-14 text-center">
      <p class="eyebrow">{t.notino.eyebrow}</p>
      <h2 class="mt-3 text-2xl sm:text-3xl text-cream max-w-xl mx-auto leading-snug">{t.notino.title}</h2>
      <a href={bookHref} {...bookAttrs} class="mt-8 inline-block rounded-full bg-gold px-12 py-3.5 text-sm tracking-[0.25em] uppercase text-ink transition hover:bg-gold-soft">
        {t.notino.button}
      </a>

      <p class="mt-10 text-sm text-sand/65">{t.notino.download}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href={business.notinoIos} target="_blank" rel="noopener" class="inline-flex items-center gap-3 rounded-xl border border-cream/20 bg-ink/40 px-5 py-2.5 transition hover:border-gold" aria-label="App Store">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-cream"><path d="M17.05 12.04c-.03-3.02 2.47-4.47 2.58-4.54-1.41-2.06-3.6-2.34-4.38-2.37-1.86-.19-3.63 1.1-4.57 1.1-.94 0-2.4-1.07-3.95-1.04-2.03.03-3.9 1.18-4.94 3-2.11 3.66-.54 9.08 1.51 12.05 1 1.45 2.2 3.08 3.77 3.02 1.51-.06 2.08-.98 3.91-.98 1.83 0 2.34.98 3.94.95 1.63-.03 2.66-1.48 3.65-2.94 1.15-1.68 1.62-3.31 1.65-3.39-.04-.02-3.17-1.22-3.2-4.83zM14.13 4.36c.83-1.01 1.39-2.41 1.24-3.81-1.2.05-2.65.8-3.51 1.81-.77.89-1.44 2.32-1.26 3.68 1.34.1 2.7-.68 3.53-1.68z"/></svg>
          <span class="text-left leading-tight">
            <span class="block text-[0.6rem] uppercase tracking-wider text-sand/60">{t.notino.getOn}</span>
            <span class="block text-sm text-cream">App Store</span>
          </span>
        </a>
        <a href={business.notinoAndroid} target="_blank" rel="noopener" class="inline-flex items-center gap-3 rounded-xl border border-cream/20 bg-ink/40 px-5 py-2.5 transition hover:border-gold" aria-label="Google Play">
          <svg width="20" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-cream"><path d="M4 2.3v19.4l16.5-9.7L4 2.3z"/></svg>
          <span class="text-left leading-tight">
            <span class="block text-[0.6rem] uppercase tracking-wider text-sand/60">{t.notino.getOn}</span>
            <span class="block text-sm text-cream">Google Play</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
