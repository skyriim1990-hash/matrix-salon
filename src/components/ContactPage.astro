---
import Layout from '../layouts/Layout.astro';
import { ui, business, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const address = lang === 'bg' ? business.addressBg : business.addressEn;
const tel = business.phone.replace(/[^+\d]/g, '');
const bookExternal = Boolean(business.bookingUrl && business.bookingUrl.length > 0);
---

<Layout lang={lang} title={`${t.nav.contact} — ${business.name}`} description={t.meta.description}>
  <section class="pt-36 pb-24 sm:pb-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="rule mb-6"></span>
        <p class="eyebrow">{t.booking.eyebrow}</p>
        <h1 class="mt-4 text-5xl sm:text-6xl text-cream">{t.booking.title}</h1>
        <p class="mt-5 text-sand/75">{t.booking.text}</p>
      </div>

      <div class="mt-16 grid gap-14 lg:grid-cols-2">
        <div class="reveal space-y-8">
          <div>
            <h2 class="text-gold text-sm tracking-widest uppercase mb-3">{t.booking.findUs}</h2>
            <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-lg text-cream/90 hover:text-gold">{address}</a>
            <div class="mt-2 space-y-1 text-sand/80">
              <a href={`tel:${tel}`} class="block hover:text-gold">{business.phone}</a>
              <a href={`mailto:${business.email}`} class="block hover:text-gold">{business.email}</a>
            </div>
          </div>
          <div>
            <h2 class="text-gold text-sm tracking-widest uppercase mb-3">{t.booking.hoursTitle}</h2>
            <ul class="text-sm space-y-1.5 text-sand/80 max-w-xs">
              {t.hoursList.map((h) => (
                <li class="flex justify-between gap-4 border-b border-white/5 pb-1.5"><span>{h.day}</span><span class="text-cream/55 tabular-nums">{h.time}</span></li>
              ))}
            </ul>
          </div>
          {bookExternal && (
            <a href={business.bookingUrl} target="_blank" rel="noopener" class="inline-block rounded-full bg-gold px-8 py-3.5 text-sm tracking-widest uppercase text-ink transition hover:bg-gold-soft">
              {t.nav.book}
            </a>
          )}
        </div>

        <form
          action="https://formspree.io/f/your-form-id"
          method="POST"
          class="reveal rounded-2xl bg-charcoal ring-1 ring-white/8 p-8 space-y-5"
        >
          <div class="grid sm:grid-cols-2 gap-5">
            <label class="block">
              <span class="text-xs tracking-widest uppercase text-sand/70">{t.booking.name}</span>
              <input name="name" type="text" required autocomplete="name" class="mt-2 w-full rounded-lg bg-ink/60 border border-white/10 px-4 py-3 text-cream focus:border-gold focus:outline-none" />
            </label>
            <label class="block">
              <span class="text-xs tracking-widest uppercase text-sand/70">{t.booking.phone}</span>
              <input name="phone" type="tel" autocomplete="tel" class="mt-2 w-full rounded-lg bg-ink/60 border border-white/10 px-4 py-3 text-cream focus:border-gold focus:outline-none" />
            </label>
          </div>
          <label class="block">
            <span class="text-xs tracking-widest uppercase text-sand/70">{t.booking.email}</span>
            <input name="email" type="email" required autocomplete="email" class="mt-2 w-full rounded-lg bg-ink/60 border border-white/10 px-4 py-3 text-cream focus:border-gold focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-xs tracking-widest uppercase text-sand/70">{t.booking.message}</span>
            <textarea name="message" rows="5" class="mt-2 w-full rounded-lg bg-ink/60 border border-white/10 px-4 py-3 text-cream focus:border-gold focus:outline-none"></textarea>
          </label>
          <button type="submit" class="w-full rounded-full bg-gold px-8 py-3.5 text-sm tracking-widest uppercase text-ink transition hover:bg-gold-soft">
            {t.booking.submit}
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
