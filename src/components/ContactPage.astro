---
import Layout from '../layouts/Layout.astro';
import { ui, business, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const address = lang === 'bg' ? business.addressBg : business.addressEn;
const tel = business.phone.replace(/[^+\d]/g, '');
const bookExternal = Boolean(business.bookingUrl && business.bookingUrl.length > 0);

// Keyless Google Maps embed — query by business name so the place card + name show.
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent('Matrix, бул. Втори Юни 19, Враца')}&z=17&hl=${lang}&output=embed`;
---

<Layout lang={lang} title={`${t.nav.contact} — ${business.name}`} description={t.meta.description}>
  <section class="pt-36 pb-24 sm:pb-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="rule mb-6"></span>
        <p class="eyebrow">{t.booking.eyebrow}</p>
        <h1 class="mt-4 text-5xl sm:text-6xl text-cream">{t.booking.title}</h1>
        <p class="mt-5 text-sand/75">{t.booking.text}</p>
      </div>

      <div class="mt-16 grid gap-14 lg:grid-cols-2">
        <div class="reveal space-y-8">
          <div>
            <h2 class="text-gold text-sm tracking-widest uppercase mb-3">{t.booking.findUs}</h2>
            <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-lg text-cream/90 hover:text-gold">{address}</a>
            <div class="mt-2 space-y-1 text-sand/80">
              <a href={`tel:${tel}`} class="block hover:text-gold">{business.phone}</a>
              <a href={`mailto:${business.email}`} class="block hover:text-gold">{business.email}</a>
            </div>
          </div>
          <div>
            <h2 class="text-gold text-sm tracking-widest uppercase mb-3">{t.booking.hoursTitle}</h2>
            <ul class="text-sm space-y-1.5 text-sand/80 max-w-xs">
              {t.hoursList.map((h) => (
                <li class="flex justify-between gap-4 border-b border-white/5 pb-1.5"><span>{h.day}</span><span class="text-cream/55 tabular-nums">{h.time}</span></li>
              ))}
            </ul>
          </div>
          {bookExternal && (
            <a href={business.bookingUrl} target="_blank" rel="noopener" class="inline-block rounded-full bg-gold px-8 py-3.5 text-sm tracking-widest uppercase text-ink transition hover:bg-gold-soft">
              {t.nav.book}
            </a>
          )}
        </div>

        <div class="reveal rounded-2xl overflow-hidden ring-1 ring-white/8 min-h-[420px] lg:min-h-full">
          <iframe
            src={mapEmbed}
            title={`${business.name} — ${address}`}
            class="w-full h-full min-h-[420px]"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>
