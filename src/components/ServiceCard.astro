---
interface Props {
  title: string;
  price: string;
  duration?: string;
  description: string;
}
const { title, price, duration, description } = Astro.props;
---

<div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-brand-light/60 transition hover:shadow-md">
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-xl text-brand-dark">{title}</h3>
    <span class="whitespace-nowrap text-lg font-semibold text-brand">{price}</span>
  </div>
  {duration && <p class="mt-1 text-xs uppercase tracking-wide text-ink/50">{duration}</p>}
  <p class="mt-3 text-sm leading-relaxed text-ink/75">{description}</p>
</div>
