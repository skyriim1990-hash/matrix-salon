{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "matrix-salon-three.vercel.app" }],
      "destination": "https://matrix-salon.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.matrix-salon.com" }],
      "destination": "https://matrix-salon.com/$1",
      "permanent": true
    }
  ]
}
